{
  "name": "@memento/agent-integration",
  "version": "0.1.0",
  "description": "Non-blocking lifecycle capture runtime for coding-agent integrations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run src",
    "test:ci": "vitest run src --reporter=basic"
  },
  "keywords": [
    "memento",
    "agent",
    "lifecycle",
    "telemetry"
  ],
  "author": "Memento Team",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
