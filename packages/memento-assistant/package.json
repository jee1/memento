{
  "name": "@memento/assistant",
  "version": "0.1.0",
  "description": "Memento SDK for external personal AI assistants (auto-recall + auto-save backend)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run --passWithNoTests",
    "test:ci": "vitest --run src test --reporter=basic"
  },
  "keywords": [
    "memento",
    "mcp",
    "memory",
    "ai",
    "assistant",
    "sdk"
  ],
  "author": "Memento Team",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@memento/client": "*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^3.2.6"
  }
}
