      "default": "./dist/domains/monitoring/services/quality-assurance/search-quality-benchmark-fixtures.js"
    },
    "./domains/monitoring/services/quality-assurance/search-quality-review-verifier.js": {
      "types": "./dist/domains/monitoring/services/quality-assurance/search-quality-review-verifier.d.ts",
      "import": "./dist/domains/monitoring/services/quality-assurance/search-quality-review-verifier.js",
      "default": "./dist/domains/monitoring/services/quality-assurance/search-quality-review-verifier.js"
    },
    "./domains/monitoring/services/quality-assurance/search-quality-metrics.js": {
      "types": "./dist/domains/monitoring/services/quality-assurance/search-quality-metrics.d.ts",
