      "default": "./dist/index.js"
    },
    "./domains/monitoring/services/quality-assurance/search-quality-benchmark-fixtures.js": {
      "types": "./dist/domains/monitoring/services/quality-assurance/search-quality-benchmark-fixtures.d.ts",
