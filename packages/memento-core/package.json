  "scripts": {
    "build": "tsc && npm run copy:assets",
    "copy:assets": "node scripts/copy-assets.js",
    "type-check": "tsc --declaration --emitDeclarationOnly",
    "db:init": "node dist/infrastructure/database/sqlite/init.js",
    "db:migrate": "node dist/infrastructure/database/sqlite/migrate.js"
