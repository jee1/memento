{
  "name": "@memento/core",
  "version": "1.17.0",
  "description": "Memento core - memory, search, anchor, forgetting, embedding (library API only)",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test/helpers/benchmark-search-database.js": {
      "types": "./dist/test/helpers/benchmark-search-database.d.ts",
      "import": "./dist/test/helpers/benchmark-search-database.js",
      "default": "./dist/test/helpers/benchmark-search-database.js"
    },
    "./test/helpers/search-quality-benchmark-fixtures.js": {
      "types": "./dist/test/helpers/search-quality-benchmark-fixtures.d.ts",
      "import": "./dist/test/helpers/search-quality-benchmark-fixtures.js",
      "default": "./dist/test/helpers/search-quality-benchmark-fixtures.js"
    },
    "./test/helpers/search-quality-review-verifier.js": {
      "types": "./dist/test/helpers/search-quality-review-verifier.d.ts",
      "import": "./dist/test/helpers/search-quality-review-verifier.js",
      "default": "./dist/test/helpers/search-quality-review-verifier.js"
    },
    "./test/helpers/search-quality-metrics.js": {
      "types": "./dist/test/helpers/search-quality-metrics.d.ts",
      "import": "./dist/test/helpers/search-quality-metrics.js",
      "default": "./dist/test/helpers/search-quality-metrics.js"
    },
    "./domains/search/factories/hybrid-search.factory.js": {
      "types": "./dist/domains/search/factories/hybrid-search.factory.d.ts",
      "import": "./dist/domains/search/factories/hybrid-search.factory.js",
      "default": "./dist/domains/search/factories/hybrid-search.factory.js"
    },
    "./shared/config/ranking-weights-loader.js": {
      "types": "./dist/shared/config/ranking-weights-loader.d.ts",
      "import": "./dist/shared/config/ranking-weights-loader.js",
      "default": "./dist/shared/config/ranking-weights-loader.js"
    },
    "./domains/monitoring/services/quality-assurance/quality-metrics-collector.js": {
      "types": "./dist/domains/monitoring/services/quality-assurance/quality-metrics-collector.d.ts",
      "import": "./dist/domains/monitoring/services/quality-assurance/quality-metrics-collector.js",
      "default": "./dist/domains/monitoring/services/quality-assurance/quality-metrics-collector.js"
    },
    "./shared/types/benchmark.types.js": {
      "types": "./dist/shared/types/benchmark.types.d.ts",
      "import": "./dist/shared/types/benchmark.types.js",
      "default": "./dist/shared/types/benchmark.types.js"
    }
  },
  "scripts": {
    "build": "tsc && npm run copy:assets",
    "copy:assets": "node scripts/copy-assets.js",
    "type-check": "tsc --declaration --emitDeclarationOnly",
    "db:init": "node dist/infrastructure/database/database/init.js",
    "db:migrate": "node dist/infrastructure/database/database/migrate.js"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
