          },
          "memory_id": {
            "description": "갱신 대상 memory_id (recall 결과나 이전 remember 응답의 값). update_mode 와 함께. 없으면 새 기억",
            "type": "string",
          },
          "privacy_scope": {
            "default": "private",
            "enum": [
              "private",
              "team",
              "public",
            ],
            "type": "string",
          },
          "record": {
            "description": "episodic 작업 기록",
            "properties": {
              "decision": {
                "description": "결정",
                "type": "string",
              },
              "failed": {
                "description": "안 통한 것. 빈 문자열 허용",
                "type": "string",
              },
              "next_blocker": {
                "description": "다음 걸림돌",
                "type": "string",
              },
              "rationale": {
                "description": "근거",
                "type": "string",
              },
              "rejected": {
                "description": "버린 대안",
                "type": "string",
              },
            },
            "required": [
              "decision",
              "rationale",
              "rejected",
              "failed",
              "next_blocker",
            ],
            "type": "object",
          },
          "reflection_notes": {
            "description": "procedural Reflexion 기록 (JSON 객체 문자열)",
            "type": "string",
          },
          "skill_name": {
            "description": "기술 이름",
            "type": "string",
          },
          "source": {
            "description": "출처",
            "type": "string",
          },
          "steps": {
            "description": "procedural 단계 (JSON 배열 문자열)",
            "type": "string",
          },
          "tags": {
            "description": "태그",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "task_goal": {
            "description": "procedural 작업 목표",
            "type": "string",
          },
          "trigger_conditions": {
            "description": "트리거 조건 (JSON 객체 문자열)",
            "type": "string",
          },
          "type": {
            "description": "기억 타입
- working: 지금 처리 중인 정보 (48시간 뒤 삭제)
- episodic: 사건, 작업 완료 기록 (30일 미사용 시 망각)
- semantic: 지식, 사실 (180일)
- procedural: 방법, 절차 (90일)
- core: 에이전트 정체성, 규칙 (key-value, 무기한, always_load 옵션)
- vault: 불변 사실 (key-value, 무기한, immutable 옵션)",
            "enum": [
              "working",
              "episodic",
              "semantic",
              "procedural",
              "core",
              "vault",
            ],
            "type": "string",
          },
          "update_mode": {
            "description": "기존 기억 갱신 방식
- replace: 새 내용으로 덮어쓴다
- incremental: 병합한다 (tags 합집합, importance 큰 값, procedural steps 이어붙이기)
- versioned: 새 행을 만들고 VERSION_OF 로 잇는다",
            "enum": [
              "replace",
              "incremental",
              "versioned",
            ],
            "type": "string",
          },
          "value": {
            "description": "core/vault 값 (필수)",
            "type": "string",
          },
          "workflow_name": {
            "description": "프로세스 이름",
            "type": "string",
          },
        },
        "required": [
          "type",
        ],
        "type": "object",
      },
      "name": "remember",
    },
    {
      "description": "Procedural Memory만 저장하는 전용 엔드포인트입니다. workflow_name, skill_name, steps 등 절차 필드를 검증한 뒤 저장합니다.",
      "inputSchema": {
        "properties": {
          "content": {
            "description": "저장할 절차 설명 (필수)",
            "type": "string",
          },
          "importance": {
            "default": 0.5,
            "description": "중요도 (0-1)",
            "maximum": 1,
            "minimum": 0,
            "type": "number",
          },
          "owner_id": {
            "description": "다중 에이전트 시 소유자 식별자 (미설정 시 context.agentId 사용)",
            "type": "string",
          },
          "privacy_scope": {
            "default": "private",
            "description": "프라이버시 범위",
            "enum": [
              "private",
              "team",
              "public",
            ],
            "type": "string",
          },
          "process_id": {
            "description": "Memori Attribution: 프로세스(에이전트/프로그램) 식별자 (Issue #87, 미설정 시 context.processId 사용)",
            "type": "string",
          },
          "reflection_notes": {
            "description": "Reflexion 기록 (JSON 객체 문자열)",
            "type": "string",
          },
          "session_id": {
            "description": "Memori Attribution: 세션(작업 흐름) 식별자 (Issue #87, 미설정 시 context.sessionId 사용)",
            "type": "string",
          },
          "skill_name": {
            "description": "기술/능력 이름 (예: 스키마 백업, 데이터 검증)",
            "type": "string",
          },
          "source": {
            "description": "출처",
            "type": "string",
          },
          "steps": {
            "description": "단계별 절차 (JSON 배열 문자열)",
            "type": "string",
          },
          "tags": {
            "description": "태그 목록",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "task_goal": {
            "description": "작업 목표 (Procedural Memory용)",
            "type": "string",
          },
          "trigger_conditions": {
            "description": "트리거 조건 (JSON 객체 문자열)",
            "type": "string",
          },
          "update_mode": {
            "description": "업데이트 모드: replace(교체), incremental(증분), versioned(버전 관리)",
            "enum": [
              "replace",
              "incremental",
              "versioned",
            ],
            "type": "string",
          },
          "workflow_name": {
            "description": "프로세스 이름 (예: 데이터 마이그레이션, API 배포)",
            "type": "string",
          },
        },
        "required": [
          "content",
        ],
        "type": "object",
      },
      "name": "remember_procedure",
    },
    {
      "description": "메모리 간의 관계를 삭제합니다. relation_id 또는 source_id/target_id/relation_type 조합으로 삭제 가능합니다. 양 끝점이 모두 현재 기억(삭제·대체 제외)이어야 하며, 한쪽이라도 superseded 이면 RELATION_NOT_FOUND 로 응답합니다(#1552).",
      "inputSchema": {
        "properties": {
          "relation_id": {
            "description": "관계 ID (relation_id 또는 source_id/target_id/relation_type 조합 중 하나는 필수)",
            "type": "number",
          },
          "relation_type": {
            "description": "관계 유형",
            "enum": [
              "CAUSES",
              "DEPENDS_ON",
              "FOLLOWS",
              "CONTRASTS_WITH",
              "REFERENCES",
              "BELONGS_TO",
            ],
            "type": "string",
          },
          "source_id": {
            "description": "소스 메모리 ID",
            "type": "string",
          },
          "target_id": {
            "description": "타겟 메모리 ID",
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "remove_relation",
    },
    {
      "description": "앵커 주변에서 국소 검색을 수행합니다",
      "inputSchema": {
        "properties": {
          "agent_id": {
            "default": "default",
            "description": "에이전트 ID (기본값: "default")",
            "type": "string",
          },
          "hop_limit": {
            "description": "최대 hop 거리 (기본값: 슬롯별 설정)",
            "maximum": 5,
            "minimum": 1,
            "type": "number",
          },
          "limit": {
            "default": 10,
            "description": "최대 결과 수",
            "maximum": 100,
            "minimum": 1,
            "type": "number",
          },
          "min_results": {
            "default": 3,
            "description": "최소 결과 수 (이보다 적으면 fallback)",
            "maximum": 100,
            "minimum": 0,
            "type": "number",
          },
          "query": {
            "description": "검색 쿼리 (선택적, 제공하지 않으면 앵커 주변 모든 메모리 반환)",
            "type": "string",
          },
          "slot": {
            "description": "검색할 앵커 슬롯",
            "enum": [
              "A",
              "B",
              "C",
            ],
            "type": "string",
          },
          "use_relations": {
            "default": true,
            "description": "관계 그래프 사용 여부 (기본값: true)",
            "type": "boolean",
          },
        },
        "required": [
          "slot",
        ],
        "type": "object",
      },
      "name": "search_local",
    },
    {
      "description": "특정 메모리를 앵커로 설정합니다",
      "inputSchema": {
        "properties": {
          "agent_id": {
            "default": "default",
            "description": "에이전트 ID (기본값: "default")",
            "type": "string",
          },
          "memory_id": {
            "description": "앵커로 설정할 메모리 ID",
            "type": "string",
          },
          "slot": {
            "description": "앵커 슬롯 (A: 즉시 컨텍스트, B: 보조 컨텍스트, C: 확장 컨텍스트)",
            "enum": [
              "A",
              "B",
              "C",
            ],
            "type": "string",
          },
        },
        "required": [
          "memory_id",
          "slot",
        ],
        "type": "object",
      },
      "name": "set_anchor",
    },
    {
      "description": "기억 고정을 해제합니다",
      "inputSchema": {
        "properties": {
          "batch": {
            "description": "배치 고정 해제할 ID 목록",
            "items": {
              "pattern": "^mem_[a-zA-Z0-9_]+$",
              "type": "string",
            },
            "maxItems": 100,
            "type": "array",
          },
          "confirm": {
            "default": false,
            "description": "고정 해제 확인",
            "type": "boolean",
          },
          "id": {
            "description": "고정 해제할 기억의 ID (배치 고정 해제시 무시됨)",
            "pattern": "^mem_[a-zA-Z0-9_]+$",
            "type": "string",
          },
          "reason": {
            "description": "고정 해제 사유",
            "maxLength": 500,
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "unpin",
    },
    {
      "description": "기억 및 관련 벡터, 관계 데이터를 영구 삭제하고 감사 증적을 남깁니다",
      "inputSchema": {
        "properties": {
          "dry_run": {
            "default": false,
            "description": "시뮬레이션 모드 (데이터 변경 없음)",
            "type": "boolean",
          },
          "id": {
            "description": "완전 삭제할 단일 기억 ID",
            "type": "string",
          },
          "retention_days": {
            "default": 30,
            "description": "보존 기간 (일 단위)",
            "type": "number",
          },
          "retention_purge": {
            "default": false,
            "description": "보존 기간 만료 기억 일괄 영구 삭제",
            "type": "boolean",
          },
          "vacuum": {
            "default": false,
            "description": "데이터베이스 vacuum 수행",
            "type": "boolean",
          },
          "zero_fill": {
            "default": true,
            "description": "벡터 테이블 0 채움 완전 파기",
            "type": "boolean",
          },
        },
        "type": "object",
      },
      "name": "wipe_memory",
    },
  ],
}
`;
