{
  "name": "memento-server",
  "version": "1.17.0",
  "description": "Memento MCP/HTTP server - consumes @memento/core",
  "type": "module",
  "private": true,
  "main": "dist/server/index.js",
  "bin": {
    "memento": "./dist/cli.js",
    "memento-mcp-server": "./dist/server/index.js",
    "memento-dev": "./dist/server/http-server.js",
    "memento-mcp": "./dist/server/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server/index.ts",
    "dev:http": "tsx watch src/server/http-server.ts",
    "dev:http-v2": "echo 'HTTP v2 not in server package yet'",
    "start": "node dist/server/index.js",
    "start:http": "node dist/server/http-server.js",
    "start:http-v2": "echo 'HTTP v2 not in server package yet'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@memento/core": "*",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "umap-js": "^1.3.3",
    "uuid": "^9.0.1",
    "ws": "^8.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
