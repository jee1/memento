{
  "name": "memento-server",
  "version": "1.17.0",
  "description": "Memento MCP/HTTP server - consumes @memento/core",
  "type": "module",
  "private": true,
  "main": "dist/server/index.js",
  "bin": {
    "memento": "./dist/cli.js",
    "memento-mcp-server": "./dist/server/index.js",
    "memento-dev": "./dist/server/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server/index.ts",
    "dev:http": "tsx watch src/server/http-server.ts",
    "start": "node dist/server/index.js",
    "start:http": "node dist/server/http-server.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@memento/agent-integration": "*",
    "@memento/core": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "umap-js": "^1.3.3",
    "uuid": "^14.0.1",
    "ws": "^8.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
