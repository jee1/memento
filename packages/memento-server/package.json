{
  "name": "memento-server",
  "version": "1.17.0",
  "description": "Memento MCP/HTTP server - consumes @memento/core",
  "type": "module",
  "private": true,
  "main": "dist/server/index.js",
  "bin": {
    "memento-mcp-server": "./dist/server/index.js",
    "memento-dev": "./dist/server/http-server.js",
    "memento-mcp": "./dist/server/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy:assets",
    "copy:assets": "node src/scripts/copy-assets.js",
    "dev": "tsx watch src/server/index.ts",
    "dev:http": "tsx watch src/server/http-server.ts",
    "start": "node dist/server/index.js",
    "start:http": "node dist/server/http-server.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@memento/core": "*"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
