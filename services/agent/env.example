# Memento Agent Environment Variables Template
# Copy to .env for local runtime:
#   cp env.example .env

# Agent model provider
AGENT_LLM_PROVIDER=ollama

# Ollama
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=qwen2.5:7b

# OpenAI (optional)
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-4o-mini

# Gemini (optional)
AGENT_GEMINI_API_KEY=
AGENT_GEMINI_MODEL=gemini-2.0-flash

# Runtime
AGENT_LOG_LEVEL=info
AGENT_TIMEOUT_MS=30000

# Memento server endpoint
MEMENTO_BASE_URL=http://localhost:9001
