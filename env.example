# Memento MCP Server Environment Variables
# 우선순위: runtime/env overrides > docker-compose defaults > 이 파일 > src/config/environment.ts 기본값

# Node / Server
NODE_ENV=development
MCP_SERVER_NAME=memento-memory
MCP_SERVER_VERSION=0.1.0
MCP_SERVER_PORT=8080
# 일부 도구 호환을 위해 PORT 값도 동일하게 유지 (선택 사항)
PORT=8080
LOG_LEVEL=info
LOG_FILE=
# CORS 허용 오리진 (쉼표 구분, 비어 있으면 크로스 오리진 미허용)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
# Admin/API/Quality 라우트 인증 (설정 시 /admin, /api, /api/v1/quality에 Authorization: Bearer <key> 또는 X-API-Key: <key> 필요)
# ADMIN_API_KEY=
# Recall 프로파일 로깅 (1이면 활성화)
# MEMENTO_RECALL_PROFILE=0
# FTS5 reflection_notes Fallback 강제 (true면 FTS 제외)
# MEMENTO_FTS5_FALLBACK_ENABLED=false

# Database
DB_PATH=./data/memory.db

# Embedding Providers
EMBEDDING_PROVIDER=minilm   # Options: tfidf, lightweight, minilm, openai, gemini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=text-embedding-3-small  # 임베딩 모델 (text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002)
OPENAI_LLM_MODEL=gpt-4o-mini  # LLM 채팅 모델 (gpt-4o-mini, gpt-3.5-turbo, gpt-4 등)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=text-embedding-004
# EMBEDDING_DIMENSIONS를 지정하지 않으면 제공자 기본값을 사용
EMBEDDING_DIMENSIONS=

# LLM Providers (관계 추출용)
LLM_PROVIDER=auto  # Options: openai, gemini, ollama, auto (auto는 사용 가능한 것 자동 선택)
OLLAMA_BASE_URL=http://localhost:11434  # Ollama 서버 URL
OLLAMA_MODEL=llama3  # Ollama 모델명 (llama3, mistral, codellama 등)

# Search
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50

# Forgetting policy TTLs (hours)
FORGET_WORKING_TTL=48
FORGET_EPISODIC_TTL=2160
FORGET_SEMANTIC_TTL=-1
FORGET_PROCEDURAL_TTL=-1

# Procedural Memory 추출 전략 (Issue #57)
# PROCEDURAL_EXTRACTION_STRATEGY=rule_only  # rule_only | llm_first (기본: rule_only)
# PROCEDURAL_LLM_EXTRACTOR_TIMEOUT_MS=10000

# Consolidation Score System
# Consolidation Score System 활성화 여부 (기본값: false)
# 활성화 시 recall_count, last_accessed_at, g_value, consolidation_score 필드가 사용됩니다
CONSOLIDATION_SCORE_ENABLED=false

# Consolidation Score 테스트 설정
# Seed 데이터 파일 경로 (선택 사항, 기본값: ./data/consolidation-seed.json)
# 파일이 없을 경우 자동으로 생성됩니다
CONSOLIDATION_TEST_SEED_PATH=./data/consolidation-seed.json

# Baseline 스냅샷 저장 경로 (선택 사항, 기본값: ./data/consolidation-baseline.json)
# 벤치마크 결과를 저장하여 향후 비교에 사용합니다
CONSOLIDATION_BASELINE_PATH=./data/consolidation-baseline.json

# 벤치마크 테스트 데이터 크기 (선택 사항, 기본값: 100)
# 테스트에 사용할 메모리 아이템 개수
CONSOLIDATION_TEST_ITEM_COUNT=100

# Security (PRD 0019: 보안 강화)
# PII 마스킹 활성화 여부 (기본값: true)
# 프로덕션에서는 항상 true로 유지해야 함 (보안 우선)
# 개발 환경에서만 선택적으로 false로 설정 가능
ENABLE_PII_MASKING=true
