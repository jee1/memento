# Memento MCP Server Environment Variables
# 우선순위: runtime/env overrides > docker-compose defaults > 이 파일 > `packages/memento-core/src/shared/config/environment.ts` 코드 기본값
# 참고: 아래 값은 "권장 로컬 프로필" 예시일 수 있으며, 코드 기본값과 다를 수 있습니다. 최소 설정은 코드 기본값을 따릅니다.

# Node / Server
NODE_ENV=development
MCP_SERVER_NAME=memento-memory
MCP_SERVER_VERSION=0.1.0
MCP_SERVER_PORT=9001
# 일부 도구 호환을 위해 PORT 값도 동일하게 유지 (선택 사항)
PORT=9001
LOG_LEVEL=info
LOG_FILE=
# CORS 허용 오리진 (쉼표 구분, 비어 있으면 크로스 오리진 미허용). MCP SSE 수동 CORS 헤더도 동일 목록 사용.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
# Admin/API/Quality 라우트 인증 (설정 시 /admin, /api, /api/v1/quality에 Authorization: Bearer <key> 또는 X-API-Key: <key> 필요)
# ADMIN_API_KEY=  # [REQUIRED in production] Legacy 단일 키 — MEMENTO_API_TOKENS 미설정 시 synthetic legacy-admin(양쪽 스코프). 신규는 아래 JSON 권장.
# MEMENTO_API_TOKENS=[{"id":"agent-tools","secret":"<hex>","scopes":["tools:invoke"]},{"id":"ops-admin","secret":"<hex>","scopes":["admin:destructive","tools:invoke"]}]
# HTTP 리슨 주소 (미설정 시 기본 127.0.0.1 — 로컬 개발·ADMIN 미설정과 호환). 모든 인터페이스에 노출하려면 예: 0.0.0.0 + ADMIN_API_KEY
# MEMENTO_HTTP_BIND_HOST=0.0.0.0
# (개발 전용) 루프백이 아닌 바인딩에서도 API 키 없이 기동 — 무인증 노출 위험, 프로덕션/공용망 사용 금지
# MEMENTO_ALLOW_INSECURE_HTTP_ADMIN=false
# HTTP /tools/recall·memory_injection owner scope (strict|warn|off, 기본 strict — Issue #664)
# MEMENTO_OWNER_SCOPE_MODE=strict
# HTTP 기본 에이전트 ID (X-Memento-Agent-Id 헤더 없을 때 ToolContext.agentId·strict owner 필터에 사용)
# MEMENTO_HTTP_DEFAULT_AGENT_ID=
# HTTP programmatic 감사 JSONL (#663). 미설정 시 {dirname(DB_PATH)}/http-audit.jsonl
# MEMENTO_HTTP_AUDIT_LOG_PATH=
# best-effort(기본) | strict(#660 hash-chain 통합 시 audit 실패 거절 예약)
# MEMENTO_HTTP_AUDIT_MODE=best-effort
# Rate limit: /tools/*, /admin/* 별 bucket (15분 창). NODE_ENV=test 또는 DISABLED=1 이면 비활성
# MEMENTO_HTTP_RATE_LIMIT_TOOLS=100
# MEMENTO_HTTP_RATE_LIMIT_ADMIN=30
# MEMENTO_HTTP_RATE_LIMIT_DISABLED=0
# Recall 프로파일 로깅 (1이면 활성화)
# MEMENTO_RECALL_PROFILE=0
# FTS5 reflection_notes Fallback 강제 (true면 FTS 제외)
# MEMENTO_FTS5_FALLBACK_ENABLED=false

# Database
# DB_PATH 기본값은 서버가 os.homedir()로 자동 결정합니다 (~/.memento/memory.db).
# 변경 시 쉘 tilde(~)는 Node 환경에서 확장되지 않으므로 절대 경로를 사용하세요.
# DB_PATH=/home/yourname/.memento/memory.db

# MCP tool exposure
# core(기본): tools/list에 recall·remember·memory_injection·feedback 4개만 노출.
# 나머지 18개는 등록된 채 tools/call로 호출 가능하며 목록에서만 빠집니다.
# full: 등록된 22개를 전부 나열 (v1.18 이전 동작).
# MEMENTO_TOOLSET=core

# Embedding Providers
EMBEDDING_PROVIDER=minilm   # Options: tfidf, lightweight, minilm, openai, gemini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=text-embedding-3-large  # 임베딩 모델 (text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002)
OPENAI_LLM_MODEL=gpt-4o-mini  # LLM 채팅 모델 (추출·요약용; 임베딩용 OPENAI_MODEL과 구분)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=text-embedding-004
GEMINI_LLM_MODEL=gemini-2.0-flash  # LLM 채팅/추출용 (임베딩 GEMINI_MODEL과 구분)
# 용도별 LLM 모델 override (설정 시 OPENAI_LLM_MODEL/GEMINI_LLM_MODEL보다 우선)
# Per-memory triple extraction queue job timeout (default 30m). Issue #475
# TRIPLE_EXTRACTION_JOB_TIMEOUT_MS=1800000

# LLM_MODEL_TRIPLE_EXTRACTION=
# LLM_MODEL_RELATION_EXTRACTION=
# LLM_MODEL_PROCEDURAL=
# LLM_MODEL_CONSOLIDATION=

# Per-job LLM provider overrides (optional; unset/empty → global LLM_PROVIDER)
# Invalid values are ignored with a one-time [CONFIG WARN] at config load.
# Prefer-then-fallback (not hard-pin): unavailable override follows existing fallback.
# LLM_PROVIDER_TRIPLE_EXTRACTION=    # openai | gemini | ollama | auto
# LLM_PROVIDER_RELATION_EXTRACTION=
# LLM_PROVIDER_PROCEDURAL=
# EMBEDDING_DIMENSIONS를 지정하지 않으면 제공자 기본값을 사용
EMBEDDING_DIMENSIONS=

# LLM Providers (관계 추출용)
LLM_PROVIDER=ollama  # Options: openai, gemini, ollama, auto
OLLAMA_BASE_URL=http://localhost:11434  # Ollama 서버 URL
OLLAMA_MODEL=llama3  # Ollama 모델명 (llama3, mistral, codellama 등)

# Telemetry / observability (006)
# Raw telemetry_events retention in days (cleanup batch job)
# TELEMETRY_RETENTION_DAYS=90
# Cleanup job interval in ms (default 24h)
# TELEMETRY_CLEANUP_INTERVAL_MS=86400000
# If true, store query plaintext in telemetry extra_data (default false — prefer query_hash only)
# TELEMETRY_STORE_QUERY_PLAINTEXT=false

# Search
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50

# Forgetting policy TTLs (hours)
FORGET_WORKING_TTL=48
FORGET_EPISODIC_TTL=2160
FORGET_SEMANTIC_TTL=-1
FORGET_PROCEDURAL_TTL=-1

# Procedural Memory 추출 전략 (Issue #57)
# PROCEDURAL_EXTRACTION_STRATEGY=rule_only  # rule_only | llm_first (기본: rule_only)
# PROCEDURAL_LLM_EXTRACTOR_TIMEOUT_MS=10000

# Consolidation Score System
# 코드 기본값은 false입니다. 이 템플릿은 로컬 검증/벤치 용도로 true를 예시합니다.
# 활성화 시 recall_count, last_accessed_at, g_value, consolidation_score 필드가 사용됩니다
CONSOLIDATION_SCORE_ENABLED=true

# Consolidation Score 테스트 설정
# Seed 데이터 파일 경로 (선택 사항, 기본값: ./data/consolidation-seed.json)
# 파일이 없을 경우 자동으로 생성됩니다
CONSOLIDATION_TEST_SEED_PATH=./data/consolidation-seed.json

# Baseline 스냅샷 저장 경로 (선택 사항, 기본값: ./data/consolidation-baseline.json)
# 벤치마크 결과를 저장하여 향후 비교에 사용합니다
CONSOLIDATION_BASELINE_PATH=./data/consolidation-baseline.json

# 벤치마크 테스트 데이터 크기 (선택 사항, 기본값: 100)
# 테스트에 사용할 메모리 아이템 개수
CONSOLIDATION_TEST_ITEM_COUNT=100

# Security (PRD 0019: 보안 강화)
# PII 마스킹 활성화 여부 (기본값: true)
# 프로덕션에서는 항상 true로 유지해야 함 (보안 우선)
# 개발 환경에서만 선택적으로 false로 설정 가능
ENABLE_PII_MASKING=true

# 기억 구조화 / 공고화 (012-fix-memory-structuring)
# 에피소딕 클러스터 최소 크기 (기본 2). 이전 하드코드 5→2.
# CONSOLIDATION_MIN_CLUSTER_SIZE=2
# 클러스터 내 유사도 임계 (기본 0.65). 환경 변수 CONSOLIDATION_SIMILARITY_THRESHOLD
# 공고화 후보 에피소딕 룩백 일수 (기본 90). CONSOLIDATION_LOOKBACK_DAYS
# 기존 시맨틱과 병합할 때 코사인 유사도 하한 (기본 0.85). CONSOLIDATION_MERGE_SIMILARITY_THRESHOLD
# Sleep 공고화 배치 간격(ms, 기본 1시간). SLEEP_CONSOLIDATION_INTERVAL_MS
# 망각 정리 배치 간격(ms, 기본 24시간) — 공고화보다 덜 자주 실행되도록 FR-004
# FORGETTING_CLEANUP_INTERVAL_MS=86400000
# TTL 소프트 삭제 후 물리 삭제까지 유예 일수 (기본 30). SOFT_DELETE_GRACE_PERIOD_DAYS

# introspection heal (#728) — admin POST /admin/introspection/heal 기본값
# demote 시 importance 곱셈 계수 (기본 0.8, 0-1). INTROSPECTION_HEAL_DEMOTE_FACTOR
# demote 하한선 (기본 0.1, 0-1). INTROSPECTION_HEAL_MIN_IMPORTANCE
# soft-delete 판단 importance 상한 (기본 0.3, 0-1). INTROSPECTION_HEAL_SOFT_DELETE_IMPORTANCE_THRESHOLD

# 배치 스케줄러 간격 (FR-003, FR-009)
# BATCH_HEALTH_CHECK_INTERVAL_MS=300000   # 헬스체크 주기 (기본: 5분, 최솟값 10000ms)
# BATCH_MONITORING_INTERVAL_MS=300000     # 성능 모니터링 수집 주기 (기본: 5분, 최솟값 10000ms)
# BATCH_JOB_PROCESSOR_INTERVAL_MS=1000   # 큐 폴링 주기 (기본: 1000ms, 최솟값 100ms)

# 성능 경고 임계값 (FR-007, FR-008)
# PERF_MEMORY_WARN_PERCENT=85   # 메모리 경고 임계값 (기본: 85%, 범위 1-100)
# PERF_CPU_WARN_PERCENT=75      # CPU 경고 임계값 (기본: 75%, 범위 1-100)
# PERF_DATABASE_WARN_MB=500     # DB 크기 경고 임계값 MB (기본: 500)
# PERF_ALERT_REARM_MS=1800000   # 알림 resolve 후 동일 타입 재발화 대기 ms (기본: 30분, 0=즉시)

# Base URL (CLI/Agent integration)
MEMENTO_BASE_URL=http://localhost:9001

# Memento Agent Environment Variables
# Source of truth for agent-only variables: services/agent/env.example
# 루트 .env에 아래 변수를 복사해 사용해도 되지만, 이름/기본값 변경은 services/agent/env.example를 우선 반영합니다.
MEMENTO_AGENT_LLM_PROVIDER=ollama
MEMENTO_AGENT_OLLAMA_BASE_URL=http://localhost:11434
MEMENTO_AGENT_OLLAMA_MODEL=qwen2.5:7b
MEMENTO_AGENT_OPENAI_API_KEY=
MEMENTO_AGENT_OPENAI_MODEL=gpt-4o-mini
MEMENTO_AGENT_GEMINI_API_KEY=
MEMENTO_AGENT_GEMINI_MODEL=gemini-2.0-flash
MEMENTO_AGENT_LOG_LEVEL=info
MEMENTO_AGENT_TIMEOUT_MS=30000

# 리뷰 후보 배치: in-process 주기 등록 on/off (GitHub #299). false면 인터벌만 끄고 POST /admin/batch/run·runJob는 유지.
# MEMORY_REVIEW_CANDIDATES_SCHEDULER_ENABLED=true

# Admin Review Queue — `review_candidates_changed` HTTP relay PoC (GitHub #297)
# Comma-separated webhook URLs; in-process SSE still runs. Use for multi-node / broker hop experiments.
# MEMENTO_REVIEW_CANDIDATES_CHANGED_RELAY_URLS=http://127.0.0.1:9999/review-candidates-changed
# Optional Bearer token for receiver auth
# MEMENTO_REVIEW_CANDIDATES_CHANGED_RELAY_SECRET=
