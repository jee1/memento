#!/usr/bin/env bash
# 로컬 1차 게이트: 자명한 결함은 PR 전에 막는다. 테스트는 CI required check 가 맡는다.
# 설치: npm run hooks:install   우회: git push --no-verify
set -euo pipefail

# 브랜치 삭제 push(local sha 가 0) 만 있으면 검사할 코드가 없다
has_update=0
while read -r _ local_sha _ _; do
  [[ "$local_sha" =~ ^0+$ ]] || has_update=1
done
[ "$has_update" = 1 ] || exit 0

echo "[pre-push] npm run lint"
npm run --silent lint
echo "[pre-push] npm run type-check"
npm run --silent type-check
