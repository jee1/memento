{
  "name": "memento-mcp-server",
  "version": "1.17.0",
  "mcpName": "io.github.jee1/memento-mcp-server",
  "description": "AI Agent 기억 보조 MCP 서버 - 사람의 기억 구조를 모사한 스토리지+검색+요약+망각 메커니즘",
  "type": "module",
  "workspaces": [
    "packages/memento-core",
    "packages/memento-server",
    "packages/memento-client",
    "packages/memento-assistant",
    "packages/memento-agent-integration",
    "apps/*"
  ],
  "bin": {
    "memento-mcp-server": "./dist/server/index.js",
    "memento-dev": "./dist/server/http-server.js",
    "memento-setup": "./scripts/auto-setup.js"
  },
  "scripts": {
    "telemetry": "npm run telemetry -w memento-server",
    "dev": "npm run dev -w memento-server",
    "dev:http": "npm run dev:http -w memento-server",
    "dev:http-v2": "npm run dev:http-v2 -w memento-server",
    "build": "npm run build:packages",
    "build:packages": "npm run build -w @memento/agent-integration && npm run build -w @memento/core && npm run build -w memento-server && npm run build -w @jee1/memento-client && npm run build -w @jee1/memento-assistant && npm run sync:root-server-dist",
    "copy:assets": "npm run copy:assets -w @memento/core",
    "docs:audit-links": "node scripts/audit-markdown-links.mjs",
    "docs:verify-npm-scripts": "node scripts/verify-doc-npm-scripts.mjs",
    "check-debt-markers": "tsx scripts/check-debt-markers.ts",
    "start": "npm run start -w memento-server",
    "start:http": "npm run start:http -w memento-server",
    "start:http-v2": "npm run start:http-v2 -w memento-server",
    "test": "npm run test:prepare && vitest --run",
    "test:server": "vitest run packages/memento-server/src/server/ --no-file-parallelism",
    "test:e2e:dashboard": "playwright test",
    "test:watch": "vitest",
    "test:ci": "vitest --run --reporter=basic",
    "test:ci:root": "vitest --run --reporter=basic tests/",
    "test:ci:core": "vitest --run --reporter=basic packages/memento-core/src/",
    "test:ci:server": "vitest --run --reporter=basic packages/memento-server/src/",
    "test:ci:scripts": "vitest --run --reporter=basic scripts --exclude '**/*.integration.spec.ts'",
    "test:vector-search-quality": "vitest --run packages/memento-core/src/test/test-vector-search-quality-with-consolidation.spec.ts",
    "test:vector-search-quality:ci": "vitest --run --reporter=junit --reporter=json --outputFile.junit=./test-results/vector-search-quality-junit.xml --outputFile.json=./test-results/vector-search-quality-results.json packages/memento-core/src/test/test-vector-search-quality-with-consolidation.spec.ts",
    "lint": "npm run lint:ts && npm run lint:js",
    "type-check": "npm run type-check -w @memento/agent-integration && npm run type-check -w @memento/core && npm run type-check -w memento-server && npm run type-check -w @jee1/memento-client && npm run type-check -w @jee1/memento-assistant && npm run type-check -w experimental-example",
    "db:init": "npm run db:init -w @memento/core",
    "db:backup": "node scripts/backup-memory-db.mjs",
    "db:restore-from-corrupt": "node scripts/restore-memory-db-from-corrupt.mjs",
    "db:pre-docker-deploy": "node scripts/pre-docker-deploy.mjs",
    "db:migrate": "npm run db:migrate -w @memento/core",
    "db:check-migration": "tsx packages/memento-server/src/scripts/check-migration-status.ts",
    "db:check-migration:help": "echo 'Usage: npm run db:check-migration [database-path]'",
    "db:check-trigger": "tsx scripts/check-and-fix-trigger.ts",
    "db:fix-trigger": "tsx scripts/check-and-fix-trigger.ts --fix",
    "memory:export": "tsx scripts/memory-export.ts",
    "memory:import": "tsx scripts/memory-import.ts",
    "forgetting:events": "tsx scripts/forgetting-events-query.ts",
    "generate-relation-report": "tsx scripts/generate-relation-report.ts",
    "weekly-relation-validation": "tsx scripts/weekly-relation-validation.ts",
    "quality:thresholds": "tsx scripts/quality-thresholds.ts",
    "quality:report": "tsx scripts/quality-report.ts",
    "quality:ground-truth:generate": "tsx scripts/generate-ground-truth.ts",
    "quality:benchmark:export": "tsx scripts/export-search-quality-benchmark.ts",
    "quality:benchmark:candidates": "tsx scripts/generate-search-quality-candidates.ts",
    "quality:benchmark:checklist": "tsx scripts/generate-search-quality-review-checklist.ts",
    "quality:benchmark:verify-review": "tsx scripts/verify-search-quality-benchmark-review.ts",
    "quality:benchmark:category-report": "tsx scripts/quality-benchmark-category-report.ts",
    "quality:benchmark:verify-categories": "tsx scripts/quality-benchmark-verify-categories.ts",
    "quality:benchmark:compare-profiles": "tsx scripts/compare-weight-profiles.ts",
    "quality:benchmark:tune-weights": "tsx scripts/tune-weights.ts",
    "quality:benchmark:tune-report": "tsx scripts/tune-report.ts",
    "quality:agent-memory:benchmark": "tsx scripts/agent-memory-benchmark.ts",
    "quality:agent-memory:production": "npm run build -w @memento/core && tsx scripts/agent-memory-benchmark.ts --production",
    "quality:agent-memory:test": "vitest run scripts/agent-memory-benchmark-adapter.spec.ts scripts/agent-memory-benchmark.spec.ts scripts/agent-memory-production-adapter.spec.ts",
    "quality:agent-integration:release-gate": "tsx scripts/agent-integration-release-gate.ts",
    "quality:agent-integration:release-gate:test": "vitest run scripts/agent-integration-release-gate.spec.ts",
    "quality:longmemeval:acquire": "tsx scripts/acquire-longmemeval.ts",
    "quality:longmemeval:validate": "tsx scripts/longmemeval-validation.ts",
    "quality:longmemeval:test": "vitest run scripts/acquire-longmemeval.spec.ts scripts/agent-memory-benchmark-adapter.spec.ts scripts/agent-memory-benchmark.spec.ts scripts/longmemeval-validation.spec.ts",
    "quality:locomo:acquire": "tsx scripts/acquire-locomo.ts",
    "quality:locomo:benchmark": "tsx scripts/agent-memory-benchmark.ts --locomo .local/locomo/locomo10.json",
    "quality:locomo:test": "vitest run scripts/acquire-locomo.spec.ts scripts/agent-memory-benchmark-adapter.spec.ts scripts/agent-memory-benchmark.spec.ts",
    "quality:agent-smoke": "node --import tsx scripts/agent-smoke-matrix.ts",
    "quality:agent-smoke:test": "vitest run scripts/agent-smoke-matrix.spec.ts",
    "quality:feedback:reappearance-report": "tsx scripts/quality-feedback-reappearance-report.ts",
    "test:quality-assurance": "tsx packages/memento-core/src/test/test-quality-assurance.ts",
    "test:client": "tsx packages/memento-server/src/test/test-client.ts",
    "test:agent-integration": "npm test -w @memento/agent-integration",
    "test:http-v2": "tsx packages/memento-server/src/test/test-http-server-v2.ts",
    "test:search": "tsx packages/memento-core/src/test/test-search.ts",
    "test:embedding": "tsx packages/memento-core/src/test/test-embedding.ts",
    "test:lightweight-embedding": "tsx packages/memento-core/src/test/test-lightweight-embedding.ts",
    "test:gemini-embedding": "tsx packages/memento-core/src/test/test-gemini-embedding.ts",
    "test:forgetting": "tsx packages/memento-core/src/test/test-forgetting.ts",
    "test:performance": "tsx packages/memento-core/src/test/performance-benchmark.ts",
    "test:multi-provider-performance": "tsx packages/memento-core/src/test/multi-provider-search-performance-benchmark.ts",
    "test:single-provider-regression": "tsx packages/memento-core/src/test/test-single-provider-regression.ts",
    "test:monitoring": "tsx packages/memento-server/src/test/test-performance-monitoring.ts",
    "test:error-logging": "tsx packages/memento-server/src/test/test-error-logging.ts",
    "test:performance-alerts": "tsx packages/memento-server/src/test/test-performance-alerts.ts",
    "test:batch-scheduler": "tsx packages/memento-core/src/test/test-batch-scheduler.ts",
    "test:vector-search": "tsx packages/memento-core/src/test/test-vector-search-engine.ts",
    "test:memory-injection": "tsx packages/memento-core/src/test/test-memory-injection-prompt.ts",
    "test:consolidation-quality": "tsx packages/memento-core/src/test/test-consolidation-search-quality.ts",
    "test:feedback-ranking": "vitest run packages/memento-core/src/test/test-feedback-ranking.spec.ts",
    "benchmark:consolidation-quality": "tsx packages/memento-core/src/test/consolidation-search-quality-benchmark.ts",
    "test:embedding-benchmark": "vitest packages/memento-core/src/test/embedding-performance-benchmark.ts",
    "test:all-embedding": "vitest packages/memento-core/src/test/embedding-*.ts --reporter=verbose",
    "migrate:embedding": "node scripts/migrate-embedding-data.js migrate",
    "migrate:embedding:analyze": "node scripts/migrate-embedding-data.js analyze",
    "migrate:embedding:rollback": "node scripts/migrate-embedding-data.js rollback",
    "test:docker": "node scripts/test-docker.js",
    "test:log-issue-monitor": "vitest run scripts/log-issue-monitor/",
    "setup": "node scripts/auto-setup.js",
    "postinstall": "node scripts/auto-setup.js",
    "rebuild-native": "npm rebuild better-sqlite3 sqlite-vec",
    "prepack": "node scripts/prepack-bundle-core.js",
    "postpack": "node scripts/postpack-restore-workspace.js",
    "pack:tarball": "node scripts/pack-with-restore.js",
    "restore-workspace": "node scripts/postpack-restore-workspace.js",
    "verify-pack-bundle": "node scripts/verify-npm-pack-bundle.js",
    "prepublishOnly": "npm run build && npm run verify-bin && npm run verify-pack-bundle",
    "verify-bin": "node scripts/verify-bin.js",
    "quick-start": "npm install && npm run setup && npm run dev",
    "backup:embeddings": "node scripts/backup-embeddings.js",
    "regenerate:embeddings": "node scripts/regenerate-embeddings.js",
    "reindex-embeddings": "tsx scripts/reindex-embeddings.ts",
    "debug:embeddings": "node scripts/debug-embeddings.js",
    "fix:vector-dimensions": "node scripts/fix-vector-dimensions.js",
    "fix:tfidf-dimensions": "tsx scripts/fix-tfidf-dimensions.ts",
    "fix:vectors": "npm run backup:embeddings && npm run regenerate:embeddings",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "ops:log-issue-monitor": "tsx scripts/log-issue-monitor/index.ts",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "build:client": "npm run build -w @jee1/memento-client",
    "dev:client": "npm run dev -w @jee1/memento-client",
    "clean:client": "npm run clean -w @jee1/memento-client",
    "publish:client": "npm publish --workspace @jee1/memento-client",
    "test:prepare": "npm run build -w @memento/agent-integration && npm run build -w @memento/core && npm run build -w memento-server",
    "lint:ts": "eslint \"{packages,apps,tests,scripts}/**/*.ts\"",
    "lint:js": "eslint \"static/js/**/*.js\"",
    "sync:root-server-dist": "node scripts/sync-root-server-dist.js",
    "build:root": "npm run build -w memento-server && npm run sync:root-server-dist",
    "quality:slop:gate": "bash scripts/slop-gate-scan.sh"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "agent",
    "sqlite",
    "vector-search",
    "typescript"
  ],
  "author": "Memento Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@huggingface/transformers": "^4.2.0",
    "@iarna/toml": "^2.2.5",
    "@memento/agent-integration": "0.1.0",
    "@memento/core": "1.17.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "openai": "^4.20.1",
    "sharp": "^0.34.4",
    "sqlite-vec": "^0.1.9",
    "umap-js": "^1.3.3",
    "uuid": "^14.0.1",
    "ws": "^8.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^8.54.0",
    "eslint-plugin-security": "^3.0.1",
    "eventsource": "^4.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "bundledDependencies": [
    "@memento/core",
    "@memento/agent-integration"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@>=10.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jee1/memento.git"
  },
  "bugs": {
    "url": "https://github.com/jee1/memento/issues"
  },
  "homepage": "https://github.com/jee1/memento#readme",
  "files": [
    "dist",
    "scripts",
    "prompts",
    "config",
    "tests/fixtures/search-quality/benchmark-v3",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "INSTALL.en.md",
    "LICENSE",
    "package.json",
    "package-lock.json"
  ]
}
